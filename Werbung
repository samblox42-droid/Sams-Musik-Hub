-- 7. RAINBOW + BIO (wie vorher)
local function getRainbowColor()
    local t = tick() * 2
    return Color3.fromHSV(t % 1, 1, 1)
end

local function setNameAndBio()
    local nameRemote = nil
    for _, obj in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if obj:IsA("RemoteEvent") and (obj.Name:find("Name") or obj.Name:find("Bio") or obj.Name:find("RP")) then
            nameRemote = obj
            break
        end
    end
    if not nameRemote then return end

    local bioText = "⚡️⚠️Sam's Musik hub by Samblox⚡️⚡️"
    local bioArgs = {"Bio", "Info", "Description", "SetBio", "RPInfo"}
    
    for _, arg in pairs(bioArgs) do
        pcall(function()
            nameRemote:FireServer(arg, bioText)
        end)
    end
end

print("🌈 Rainbow Name + Bio Changer wird aktiviert...")

