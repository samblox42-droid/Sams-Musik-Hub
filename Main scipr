-- ============================================
-- TAB SWITCHING
-- ============================================
local function SwitchTab(name)
    for n, page in pairs(Pages) do
        page.Visible = (n == name)
        if n == name then
            TabButtons[n].BackgroundColor3 = Theme.TabActive
            TabButtons[n].TextColor3 = Color3.new(1,1,1)
        else
            TabButtons[n].BackgroundColor3 = Theme.Button
            TabButtons[n].TextColor3 = Theme.TextDark
        end
    end

    if name == "Hits" then BuildHits()
    elseif name == "Saved" then BuildSaved()
    elseif name == "Settings" then BuildSettings()
    elseif name == "Update" then BuildUpdate()
    elseif name == "Credits" then BuildCredits()
    end
end

for name, btn in pairs(TabButtons) do
    btn.MouseButton1Click:Connect(function()
        SwitchTab(name)
    end)
end

-- ============================================
-- DRAG FUNCTION
-- ============================================
local dragging = false
local dragStart = nil
local startPos = nil

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

TitleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

