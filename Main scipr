-- ============================================
-- THEME APPLY FUNCTION
-- ============================================
local function ApplyTheme()
    Theme = Themes[CurrentTheme]
    Main.BackgroundColor3 = Theme.Background
    TitleBar.BackgroundColor3 = Theme.Secondary
    TitleFix.BackgroundColor3 = Theme.Secondary
    Title.TextColor3 = Theme.Accent
    MainStroke.Color = Theme.Accent
    MinBtn.BackgroundColor3 = Theme.Button
    MinBtn.TextColor3 = Theme.Text
    CloseBtn.BackgroundColor3 = Theme.Danger

    for name, btn in pairs(TabButtons) do
        if Pages[name].Visible then
            btn.BackgroundColor3 = Theme.TabActive
            btn.TextColor3 = Color3.new(1,1,1)
        else
            btn.BackgroundColor3 = Theme.Button
            btn.TextColor3 = Theme.TextDark
        end
    end

    -- Song Buttons neu färben
    for _, page in pairs(Pages) do
        for _, child in ipairs(page:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = Theme.Button
                child.TextColor3 = Theme.Text
            elseif child:IsA("TextLabel") then
                child.TextColor3 = Theme.Text
            elseif child:IsA("Frame") then
                child.BackgroundColor3 = Theme.Secondary
            end
        end
    end
end

-- ============================================
-- SONG PLAY FUNCTION
-- ============================================
local function PlaySong(songId, songName)
    CurrentPlaying = songName
    pcall(function()
        local args = {
            [1] = "PlaySong",
            [2] = songId
        }
        -- Brookhaven Vehicle Remote
        local remote = ReplicatedStorage:FindFirstChild("1NoMoto1rVehicle1s")
            or ReplicatedStorage:FindFirstChild("RE")
            or ReplicatedStorage:FindFirstChild("RemoteEvent")

        -- Versuche mehrere mögliche Wege
        for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") and (obj.Name:lower():find("vehicle") or obj.Name:lower():find("music") or obj.Name:lower():find("radio") or obj.Name:lower():find("sound")) then
                pcall(function()
                    obj:FireServer("Play", songId)
                    obj:FireServer(songId)
                    obj:FireServer("PlaySong", songId)
                end)
            end
        end

        -- Fallback: Chat Command Style (manche Games)
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then
                -- nicht nötig
            end
        end
    end)
end

