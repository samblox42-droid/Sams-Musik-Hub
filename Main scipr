local function ApplyTheme()
    Theme = Themes[CurrentTheme]
    Main.BackgroundColor3 = Theme.Background
    TitleBar.BackgroundColor3 = Theme.Secondary
    TitleFix.BackgroundColor3 = Theme.Secondary
    Title.TextColor3 = Theme.Accent
    MainStroke.Color = Theme.Accent
    MinBtn.BackgroundColor3 = Theme.Button
    MinBtn.TextColor3 = Theme.Text
    CloseBtn.BackgroundColor3 = Theme.Danger

    for name, btn in pairs(TabButtons) do
        if Pages[name].Visible then
            btn.BackgroundColor3 = Theme.TabActive
            btn.TextColor3 = Color3.new(1,1,1)
        else
            btn.BackgroundColor3 = Theme.Button
            btn.TextColor3 = Theme.TextDark
        end
    end
end

-- ===================== PLAY SONG =====================
local function PlaySong(songId, songName)
    pcall(function()
        for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                local n = obj.Name:lower()
                if n:find("vehicle") or n:find("music") or n:find("radio") or n:find("sound") or n:find("moto") then
                    pcall(function()
                        obj:FireServer("Play", songId)
                        obj:FireServer(songId)
                        obj:FireServer("PlaySong", songId)
                        obj:FireServer("1NoMoto1rVehicle1s", songId)
                    end)
                end
            end
        end
    end)
end

-- ===================== BUILD HITS =====================
local function BuildHits()
    local page = Pages["Hits"]
    for _, c in ipairs(page:GetChildren()) do
        if not c:IsA("UIListLayout") then c:Destroy() end
    end

    for _, song in ipairs(HitsSongs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -6, 0, 38)
        btn.BackgroundColor3 = Theme.Button
        btn.Text = "  ▶   " .. song.Name
        btn.TextColor3 = Theme.Text
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 14
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.AutoButtonColor = false
        btn.Parent = page
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.ButtonHover}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Button}):Play()
        end)

        btn.MouseButton1Click:Connect(function()
            PlaySong(song.Id, song.Name)
            btn.Text = "  ♫   " .. song.Name .. "   (Playing)"
            task.delay(2, function()
                if btn and btn.Parent then
                    btn.Text = "  ▶   " .. song.Name
                end
            end)
        end)

        btn.MouseButton2Click:Connect(function()
            local exists = false
            for _, s in ipairs(SavedSongs) do
                if s.Id == song.Id then exists = true break end
            end
            if not exists then
                table.insert(SavedSongs, {Name = song.Name, Id = song.Id})
                SavePlaylist()
                btn.Text = "  ★   " .. song.Name .. "   (Saved)"
                task.delay(1.4, function()
                    if btn and btn.Parent then btn.Text = "  ▶   " .. song.Name end
                end)
            end
        end)
    end
    page.CanvasSize = UDim2.new(0, 0, 0, #HitsSongs * 44)
end

